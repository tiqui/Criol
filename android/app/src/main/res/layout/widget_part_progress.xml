<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de progresso fina e tempos (decorrido / restante), como no player do app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/wg_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wg_bar_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/wg_elapsed"
            style="@style/Widget.Criol.Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Chronometer
            android:id="@+id/wg_remaining"
            style="@style/Widget.Criol.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
