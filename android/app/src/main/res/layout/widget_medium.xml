<?xml version="1.0" encoding="utf-8"?>
<!-- 3x3: capa desfocada de fundo; capa e textos em cima, progresso e controles embaixo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wg_card"
        style="@style/Widget.Criol.Card" />

    <ImageView
        android:id="@+id/wg_backdrop"
        style="@style/Widget.Criol.Backdrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <ImageView
                    android:id="@+id/wg_art_tile"
                    style="@style/Widget.Criol.ArtTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/wg_art_note"
                    style="@style/Widget.Criol.ArtNote"
                    android:padding="22dp" />

                <ImageView
                    android:id="@+id/wg_art"
                    style="@style/Widget.Criol.Art" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/wg_title"
                    style="@style/Widget.Criol.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/widget_idle_title" />

                <TextView
                    android:id="@+id/wg_artist"
                    style="@style/Widget.Criol.Artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/widget_idle_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include layout="@layout/widget_part_progress" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include layout="@layout/widget_part_transport" />
    </LinearLayout>
</FrameLayout>
