<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4: capa desfocada de fundo, capa quadrada em destaque, textos, progresso e controles. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wg_card"
        style="@style/Widget.Criol.Card" />

    <ImageView
        android:id="@+id/wg_backdrop"
        style="@style/Widget.Criol.Backdrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <!-- adjustViewBounds + quadrado = capa quadrada da altura que sobrar -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wg_art_tile"
                style="@style/Widget.Criol.ArtTile"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/wg_art_note"
                style="@style/Widget.Criol.ArtNote"
                android:padding="40dp" />

            <ImageView
                android:id="@+id/wg_art"
                style="@style/Widget.Criol.Art" />
        </FrameLayout>

        <TextView
            android:id="@+id/wg_title"
            style="@style/Widget.Criol.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textSize="17sp"
            android:text="@string/widget_idle_title" />

        <TextView
            android:id="@+id/wg_artist"
            style="@style/Widget.Criol.Artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_horizontal"
            android:textSize="14sp"
            android:text="@string/widget_idle_subtitle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <include layout="@layout/widget_part_progress" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <include layout="@layout/widget_part_transport" />
    </LinearLayout>
</FrameLayout>
