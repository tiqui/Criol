<?xml version="1.0" encoding="utf-8"?>
<!-- 3x1: igual ao mini player do app. Capa, título/artista, [próxima] e play. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wg_card"
        style="@style/Widget.Criol.Card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/wg_art_tile"
                style="@style/Widget.Criol.ArtTile"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/wg_art_note"
                style="@style/Widget.Criol.ArtNote"
                android:padding="12dp" />

            <ImageView
                android:id="@+id/wg_art"
                style="@style/Widget.Criol.Art" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/wg_title"
                style="@style/Widget.Criol.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="14sp"
                android:text="@string/widget_idle_title" />

            <TextView
                android:id="@+id/wg_artist"
                style="@style/Widget.Criol.Artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_idle_subtitle" />
        </LinearLayout>

        <ImageView
            android:id="@+id/wg_next"
            style="@style/Widget.Criol.Control"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/wg_next"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/wg_play"
            style="@style/Widget.Criol.PlayButton"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/wg_play_bg"
                style="@style/Widget.Criol.PlayCircle" />

            <ImageView
                android:id="@+id/wg_play_icon"
                style="@style/Widget.Criol.PlayIcon"
                android:padding="8dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
