<?xml version="1.0" encoding="utf-8"?>
<!-- Prévia da barra de progresso (no widget real ela é desenhada com o progresso). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/wg_track" />
        </shape>
    </item>
    <item android:right="140dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/wg_foreground" />
        </shape>
    </item>
</layer-list>
