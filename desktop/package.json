{
    "name": "criol",
    "version": "2.1.0",
    "private": true,
    "license": "MIT",
    "description": "Criol - player de música para pastas locais, Navidrome/Subsonic e Jellyfin",
    "author": {
        "name": "tiqui",
        "email": "tiqui@users.noreply.github.com"
    },
    "homepage": "https://github.com/tiqui/Criol",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "dev:web": "vite --config vite.web.config.ts",
        "build": "pnpm run build:electron && pnpm run build:web",
        "build:electron": "electron-vite build",
        "build:web": "vite build --config vite.web.config.ts",
        "preview:web": "vite preview --config vite.web.config.ts",
        "start": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "lint": "pnpm run typecheck && eslint --max-warnings=0 .",
        "test": "vitest run",
        "package": "pnpm run build:electron && electron-builder",
        "package:win": "pnpm run build:electron && electron-builder --win",
        "package:linux": "pnpm run build:electron && electron-builder --linux",
        "package:mac": "pnpm run build:electron && electron-builder --mac"
    },
    "dependencies": {
        "music-metadata": "^11.16.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@tanstack/react-virtual": "^3.13.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "clsx": "^2.1.1",
        "electron": "^43.8.7",
        "electron-builder": "^26.18.0",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.0.0",
        "i18next": "^25.10.10",
        "idb-keyval": "^6.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^16.6.6",
        "react-icons": "^5.7.0",
        "react-router": "^7.18.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.40.0",
        "vite": "^7.3.7",
        "vitest": "^3.2.0",
        "zustand": "^5.1.0"
    },
    "packageManager": "pnpm@11.5.2",
    "productName": "Criol"
}
